# Login page URL. Override only with an authorized Sauce Labs test tenant.
SAUCE_AUTH_URL=https://accounts.saucelabs.com/am/XUI/#login/

# Credentials for a dedicated, authorized test account. Never use production user credentials.
SAUCE_AUTH_USERNAME=
SAUCE_AUTH_PASSWORD=

# URL fragment or path that uniquely identifies a successful login in your test tenant.
SAUCE_AUTH_SUCCESS_URL=

# Credential-submission scenarios are disabled unless explicitly enabled.
SAUCE_ALLOW_AUTH_SUBMISSION=false
